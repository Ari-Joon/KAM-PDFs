# Files git must never treat as text. A PDF is mostly binary, but some are plain enough that git
# guesses "text", and then changes their line endings on checkout, which breaks them.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.wasm binary
*.traineddata binary
*.zip binary
*.gz binary

# Windows scripts keep Windows line endings, whoever builds the release zip.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Left out of the release zip (setup/build-release.js builds it with git archive).
/tests export-ignore
/screenshots export-ignore
/.gitignore export-ignore
/.gitattributes export-ignore
